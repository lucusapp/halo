# Clerk (https://dashboard.clerk.com -> API Keys) — misma app de Clerk que usa
# packages/api, así que CLERK_SECRET_KEY debe ser idéntica en ambos .env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Opcional: solo si la app se sirve detrás de un proxy con prefijo de ruta (ej. el
# proxy de puertos de VS Code Server, http://<host>/proxy/<puerto>/). Déjala sin
# definir para desarrollo local normal en la raíz. Ver next.config.mjs.
# BASE_PATH="/proxy/3000"

# URL del backend de packages/api (fetch server-side desde los Server Components).
API_URL="http://localhost:3001"
